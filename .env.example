APP_NAME="CBT TOEFL Al-Ma'soem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_toefl_almasoem
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Queue (untuk AI grading async)
QUEUE_CONNECTION=database

# Filesystem (untuk audio & export)
FILESYSTEM_DISK=local

# AI Service Configuration 


# Excel Export
EXCEL_EXPORT_PATH=ekspor

# Exam Configuration
MAX_EXAM_PARTICIPANTS=3000
EXAM_TAB_LOCK_ENABLED=true
EXAM_AUTO_SUBMIT_ON_TAB_SWITCH=false

# Audio Configuration
AUDIO_MAX_SIZE=10240
AUDIO_ALLOWED_FORMATS=mp3,wav

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug